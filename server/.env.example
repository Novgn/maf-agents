# Azure Authentication
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Azure Kusto (Data Explorer)
KUSTO_CLUSTER_URL=https://your-cluster.region.kusto.windows.net
KUSTO_DATABASE_NAME=your-database

# Azure DevOps / Azure Repos
AZURE_DEVOPS_ORG=https://dev.azure.com/your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_REPO=your-repository

# Azure Table Storage (for checkpoints)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
CHECKPOINT_TABLE_NAME=workflowcheckpoints

# Azure Table Storage (for session management)
# Uses DefaultAzureCredential (Azure CLI, Managed Identity, Service Principal)
# Example: https://your-storage-account.table.core.windows.net
AZURE_STORAGE_ENDPOINT=https://your-storage-account.table.core.windows.net
AZURE_TABLE_NAME=WorkflowSessions

# Logging
LOG_LEVEL=INFO
